# Canned session for the scripted-session gate (run-gui-tests.sh):
# exercises key press/release, host-repeat suppression, out-of-table
# discard, focus-loss release synthesis, mouse clamping and dedup, and
# the Escape halt. Grammar per gui/sdl_main.c; the clock is fake, so
# the whole session is deterministic. ~2000 cycles/ms at default --hz.
wait 30
keydown 0x04
wait 5
keyrepeat 0x04
keyup 0x04
wait 5
keydown 0x65
keydown 0xE1
wait 5
focuslost
wait 5
mouse 100 200 1
wait 3
mouse 100 200 0
mouse 5000 5000 0
wait 5
keydown 0x29
wait 20
close
