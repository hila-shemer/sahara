load("@rightwayc//bzl:rwc.bzl", "rwc_binary", "rwc_library", "rwc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

rwc_library(
    name = "core",
    srcs = [
        "cpu.c",
        "dev.c",
        "fp.c",
        "hostmem.c",
        "image.c",
        "mem.c",
        "sha256.c",
        "trace.c",
    ],
    hdrs = [
        "cpu.h",
        "dev.h",
        "fp.h",
        "hostmem.h",
        "image.h",
        "mem.h",
        "platform.h",
        "sha256.h",
        "trace.h",
        "u128.h",
        "gen/sahara_isa.h",
        "gen/spec_version.h",
    ],
)

rwc_binary(
    name = "sahara-emu",
    srcs = ["main.c"],
    deps = [":core"],
)

# The interactive front end. sdl_main.c is the sanctioned SDL shim
# carve-out (emu-c-gui-frontend-prompt.md): allow_banned drops the
# poison header, SDL2 comes from system headers + linkopts (no BCR
# dep), and the TU stays out of the source audits below. nic_host.c
# is the socket carve-out on the identical pattern -- both TUs only
# move bytes; everything with logic in it lives in :gui_core instead,
# and neither ever links into :core or sahara-emu (audit_banned_syms
# on the headless binary is the structural NIC-C-35 check).
rwc_binary(
    name = "sahara-gui",
    srcs = [
        "gui/nic_host.c",
        "gui/nic_host.h",
        "gui/sdl_main.c",
    ],
    allow_banned = True,
    linkopts = ["-lSDL2"],
    deps = [
        ":core",
        ":gui_core",
    ],
)

# The record->replay keystone (run-gui-tests.sh): plays the front
# end's role through SeCpu_feed against scripted guests, no SDL.
rwc_binary(
    name = "gui-seam-driver",
    srcs = ["gui/seam_driver.c"],
    deps = [":core"],
)

# The SDL-free half of the GUI front end (translation, HID filter,
# frame blit, the sans-IO NIC translator and its socket-free fake
# backend): full doctrine, unit-tested by test_gui/test_nic. Only the
# SDL and socket shims get the carve-out.
rwc_library(
    name = "gui_core",
    srcs = [
        "gui/blit.c",
        "gui/hid_map.c",
        "gui/nic.c",
        "gui/nic_fake.c",
        "gui/translate.c",
    ],
    hdrs = [
        "gui/blit.h",
        "gui/hid_map.h",
        "gui/nic.h",
        "gui/nic_fake.h",
        "gui/translate.h",
    ],
    deps = [":core"],
)

rwc_test(
    name = "test_core",
    srcs = ["test_core.c"],
    tier = "short",
    deps = [":core"],
)

rwc_test(
    name = "test_fp",
    srcs = ["test_fp.c"],
    tier = "short",
    deps = [":core"],
)

rwc_test(
    name = "test_dev",
    srcs = ["test_dev.c"],
    tier = "short",
    deps = [":core"],
)

rwc_test(
    name = "test_gui",
    srcs = ["test_gui.c"],
    tier = "short",
    deps = [
        ":core",
        ":gui_core",
    ],
)

rwc_test(
    name = "test_nic",
    srcs = ["test_nic.c"],
    tier = "short",
    deps = [
        ":core",
        ":gui_core",
    ],
)

# Post-build audits (doctrine 2.2), hand-wired: rw_audit would also wire
# the worst-case-stack audit, which needs hand-checked bounds for this
# binary's libc callees (fopen/fread/strtoull/...) added to rightwayc's
# audit/libc_stack.tsv -- a rightwayc change this repo must not make
# unilaterally. Until those rows land upstream, wire the four audits
# that stand on their own.
#
# gui/ splits: the SDL-free sources join the source audits; the SDL
# shim (sdl_main.c) and the socket shim (nic_host.c) are the
# sanctioned carve-outs and stay out, as does the sahara-gui binary
# from banned_syms (SDL drags in most of libc). nic_host.h has no
# socket types and stays audited.
AUDIT_SRCS = glob(
    ["*.c", "*.h", "gen/*.h", "gui/*.c", "gui/*.h"],
    exclude = [
        "gui/nic_host.c",
        "gui/sdl_main.c",
    ],
)

sh_test(
    name = "audit_banned_syms",
    srcs = ["@rightwayc//audit:banned_syms.sh"],
    args = ["$(rootpath :sahara-emu)"],
    data = [":sahara-emu"],
    tags = ["no_coverage"],
)

sh_test(
    name = "audit_tls",
    srcs = ["@rightwayc//audit:tls_check.sh"],
    args = ["$(rootpath :sahara-emu)"],
    data = [":sahara-emu"],
    tags = ["no_coverage"],
)

sh_test(
    name = "audit_ctx",
    srcs = ["@rightwayc//audit:ctx_check.sh"],
    args = ["$(rootpaths %s)" % s for s in AUDIT_SRCS],
    data = AUDIT_SRCS,
)

sh_test(
    name = "audit_with",
    srcs = ["@rightwayc//audit:with_wrapper.sh"],
    args = ["$(rootpath @rightwayc//audit:with_check.py)"] +
           ["$(rootpaths %s)" % s for s in AUDIT_SRCS],
    data = AUDIT_SRCS + ["@rightwayc//audit:with_check.py"],
)
