# Sahara conformance suite manifest.
# Format: NAME SRC [level=N] [expect=<hex32>|expect=checkfail] [flags]
# run-tests.sh prepends tests/defs.s to every assembly and always passes
# --check-invtp. difftest.sh forces trace level 1 (per toolchain-prompt).
# expect= overrides the required HALT r0 line (default PASS magic 600d)
# for tests that end in a non-HALT-instruction halt (SPEC-ISSUES 12).
# expect=checkfail: the correct outcome is a check-mode assertion —
# exit 3, stdout first word CHECKFAIL, reason text not compared
# (SPEC-ISSUES 22/23).
c0_smoke c0_smoke.s
c1_traps c1_traps.s
c1_triplefault c1_triplefault.s expect=00000000000000000000000000003f3f
c1_wfihang c1_wfihang.s expect=00000000000000000000000000057a11
c2_mmu c2_mmu.s
c2_noinvtp_remap c2_noinvtp_remap.s expect=checkfail
c2_noinvtp_ptbase c2_noinvtp_ptbase.s expect=checkfail
c3_atomics c3_atomics.s
c3_irq_dev c3_irq_dev.s level=2
c4_fp c4_fp.s
c5_base c5_base.s
c6_control c6_control.s level=2
c7_mem c7_mem.s
c7_dev c7_dev.s level=2
# same image under the weak-store check mode (ISA 9.2): the queue must
# be semantics-neutral on a single CPU — identical pass, same checks
c7_dev_ordq c7_dev.s level=2 --check-devorder 4
# EVENT-fed tests (events=GEN.py): the feed generator emits a replay
# trace (META + EVENT records) consumed via --replay — the CLI's only
# headless event source. Skipped unless REPLAY=1 (they need the
# emulator to implement --replay). level=2: their checks read MEMRs.
c7_kbd c7_kbd.s level=2 events=c7_kbd.py
c7_kbd_ovf c7_kbd_ovf.s level=2 events=c7_kbd_ovf.py
c7_resize c7_resize.s level=2 events=c7_resize.py
# TIMER device tests (devspec/timer.md). Deterministic by construction
# — no events= feed exists for type 5 — so all four run everywhere and
# the REPLAY=1 leg replays each run's own trace (TMR-21). level=2:
# their checks read the COUNT/STATUS MEMRs.
c7_timer_tick c7_timer_tick.s level=2
c7_timer_deverr c7_timer_deverr.s level=2
c7_timer_wfi c7_timer_wfi.s level=2
c7_timer_indep c7_timer_indep.s level=2
