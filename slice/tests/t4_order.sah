// MMIO ordering probe: a run of plain stores immediately followed by the
// doorbell MMIO store, all in one function so no loads intervene.
int main() {
    i32* fb = 0x20000000;
    i128* door = 0x1F000000;
    int i = 0;
    while (i < 1000) { fb[i] = 255; i = i + 1; }
    *door = 1;
    return 0;
}
