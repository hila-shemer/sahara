#!/usr/bin/env python3
"""Sahara emulator, Python implementation — the independent cross-check.

CLI contract (frozen, emu-common-prompt.md):
  sahara-emu-py IMAGE [--replay events.trc] [--trace out.trc
      --trace-level N] [--maxcycles N] [--ram BYTES] [--check-invtp]
      [--check-devorder N]

HALT -> "HALT r0=<32 hex digits>", exit 0. --maxcycles exhaustion ->
"MAXCYCLES", exit 2. Check-mode assertion -> "CHECKFAIL <reason>",
exit 3. Internal errors: message on stderr, nonzero exit.
"""

import argparse
import hashlib
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _HERE)
sys.path.insert(1, os.path.dirname(_HERE))     # repo root: encoding.py

import encoding as E            # noqa: E402
import image                    # noqa: E402
import machine                  # noqa: E402
import mem                      # noqa: E402
import trc                      # noqa: E402

DEFAULT_RAM = 256 * 1024 * 1024


def parse_args(argv):
    p = argparse.ArgumentParser(prog="sahara-emu-py", add_help=True)
    p.add_argument("image")
    p.add_argument("--replay", metavar="events.trc")
    p.add_argument("--trace", metavar="out.trc")
    p.add_argument("--trace-level", type=int, default=1, choices=(0, 1, 2))
    p.add_argument("--maxcycles", type=int, default=None)
    p.add_argument("--ram", type=int, default=DEFAULT_RAM)
    p.add_argument("--check-invtp", action="store_true")
    p.add_argument("--check-devorder", type=int, default=None, metavar="N")
    return p.parse_args(argv)


def load_events(path):
    events = []
    with open(path, "rb") as f:
        for typ, payload in trc.read_records(f):
            if typ == trc.T_EVENT:
                events.append(trc.parse_event(payload))
    return events


def main(argv):
    args = parse_args(argv)
    with open(args.image, "rb") as f:
        img_data = f.read()

    phys = mem.PhysMap(args.ram, devorder=args.check_devorder,
                       dev_base=image.DEV_SPACE_BASE)
    image.load_image(phys, img_data)
    image.write_device_table(phys, args.ram)

    events = load_events(args.replay) if args.replay else []

    tracer = None
    trace_file = None
    if args.trace:
        trace_file = open(args.trace, "wb")
        tracer = trc.TraceWriter(trace_file, args.trace_level)
        modes = []
        if args.check_invtp:
            modes.append("invtp")
        if args.check_devorder is not None:
            modes.append(f"devorder={args.check_devorder}")
        if args.replay:
            modes.append("replay")
        tracer.meta([
            ("image", os.path.basename(args.image)),
            ("sha256", hashlib.sha256(img_data).hexdigest()),
            ("encoding", E.SPEC_VERSION),
            ("level", args.trace_level),
            ("modes", ",".join(modes) or "none"),
        ])

    m = machine.Machine(phys, tracer=tracer, check_invtp=args.check_invtp,
                        events=events)
    try:
        outcome = m.run(maxcycles=args.maxcycles)
    except machine.CheckFail as cf:
        reason = " ".join(str(cf).split())
        print(f"CHECKFAIL {reason}")
        return 3
    finally:
        if tracer:
            tracer.close()
        if trace_file:
            trace_file.close()

    if outcome == "maxcycles":
        print("MAXCYCLES")
        return 2
    print(f"HALT r0={m.rreg(0):032x}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (image.ImageError, OSError, RuntimeError, ValueError) as e:
        print(f"sahara-emu-py: {e}", file=sys.stderr)
        sys.exit(1)
