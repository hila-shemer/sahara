#!/usr/bin/env python3
"""trace-q — Sahara execution-trace query tool.

TOOLING-SPEC 3.3 as elaborated by devspec/trace.md 6 (CLI, exit codes,
output line grammar, symbolization, disassembly canonical form — the
trace.md 8 vectors are the acceptance data).

  trace-q [--sym FILE] exec CYCLE TRACE
  trace-q [--sym FILE] at PC TRACE
  trace-q [--sym FILE] last-write ADDR [--before CYCLE] TRACE
  trace-q            reg R --at CYCLE TRACE
  trace-q [--sym FILE] find (--pc X | --wrote-reg R=V | --touched A)
                           [--from C] [--to C] TRACE
  trace-q            diverge A.trc B.trc
  trace-q [--sym FILE] range C1 C2 TRACE
  trace-q [--sym FILE] trapdump TRACE

Exit codes (trace.md 6.2): 0 = at least one output line; 1 = valid
query, zero matching facts (empty stdout); 2 = error (bad usage,
unreadable file, malformed trace or .sym, META validation failure).
stdout carries only facts; every diagnostic goes to stderr. Every
stdout line is space-separated key=value tokens; only the final token
(asm=, a=, b=) may contain spaces. Absent values print as `-`.
Numbers accept decimal, 0x hex, 0b binary.
"""

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
sys.path.insert(0, os.path.dirname(HERE))

import encoding as E          # noqa: E402
import disasm as D            # noqa: E402
import tracefile as T         # noqa: E402

CAUSE_NAMES = {v: k for k, v in E.CAUSES.items()}
# trace.md 2.3.4: causes whose baddr is architecturally 0 print baddr=-
BADDRLESS = {E.CAUSES[c] for c in ("TIMER", "EXTINT", "ILLEGAL",
                                   "SYSCALL", "PRIV")}


def die(msg):
    print(f"trace-q: error: {msg}", file=sys.stderr)
    sys.exit(2)


def num(text, what):
    try:
        return int(text, 0)
    except ValueError:
        die(f"{what}: not a number: {text!r}")


def take_opt(args, name, has_value=True):
    if name in args:
        i = args.index(name)
        if has_value:
            if i + 1 >= len(args):
                die(f"{name} needs a value")
            v = args[i + 1]
            del args[i:i + 2]
            return v
        del args[i]
        return True
    return None


def h128(v):
    return f"0x{v:032x}"


def sym_str(addr, symtab):
    if symtab is None:
        return "-"
    return symtab.lookup(addr) or "-"


def render_exec(rec, symtab):
    f = rec.fields
    flags = f["flags"]
    squashed = 1 if flags & T.FLAG_SQUASHED else 0
    wb = h128(f["wb"]) if flags & T.FLAG_WROTE_DST else "-"
    pred = f"0x{f['pred_wb']:02x}" if flags & T.FLAG_WROTE_PRED else "-"
    return (f"cycle={f['cycle']} pc={h128(f['pc'])} "
            f"sym={sym_str(f['pc'], symtab)} insn=0x{f['insn']:016x} "
            f"squashed={squashed} wb={wb} pred={pred} "
            f"asm={D.disasm(f['insn'])}")


def render_mem(rec, symtab):
    f = rec.fields
    return (f"type={rec.name} cycle={f['cycle']} ea={h128(f['ea'])} "
            f"sym={sym_str(f['ea'], symtab)} size={f['size']} "
            f"val={h128(f['val'])}")


def render_trap(rec, symtab):
    f = rec.fields
    cause = CAUSE_NAMES.get(f["cause"], str(f["cause"]))
    baddr = "-" if f["cause"] in BADDRLESS else h128(f["baddr"])
    return (f"cycle={f['cycle']} cause={cause} epc={h128(f['epc'])} "
            f"sym={sym_str(f['epc'], symtab)} baddr={baddr} "
            f"tl={f['tl_after']}")


def render_event(rec):
    f = rec.fields
    return (f"type=EVENT cycle={f['cycle']} device={f['device']} "
            f"payload_len={len(f['bytes'])} data={f['bytes'].hex()}")


def render(rec, symtab):
    if rec.type == T.T_EXEC:
        return render_exec(rec, symtab)
    if rec.type in (T.T_MEMW, T.T_MEMR, T.T_DEVW):
        return render_mem(rec, symtab)
    if rec.type == T.T_TRAP:
        return render_trap(rec, symtab)
    if rec.type == T.T_EVENT:
        return render_event(rec)
    return f"type={rec.name}"


def load(path, symtab_path):
    try:
        recs = T.read_records(path)
        symtab = T.Symtab(T.load_sym(symtab_path)) if symtab_path else None
    except T.TraceError as e:
        die(str(e))
    return recs, symtab


def insn_field(insn, name):
    lsb, width = E.FIELDS[name]
    return (insn >> lsb) & ((1 << width) - 1)


def finish(nlines):
    sys.exit(0 if nlines else 1)


# ---------------------------------------------------------------- commands


def cmd_exec(args, sym):
    if len(args) != 2:
        die("usage: [--sym FILE] exec CYCLE TRACE")
    cycle = num(args[0], "cycle")
    recs, symtab = load(args[1], sym)
    for r in recs:
        if r.type == T.T_EXEC and r.fields["cycle"] == cycle:
            print(render_exec(r, symtab))
            finish(1)
    finish(0)


def cmd_at(args, sym):
    if len(args) != 2:
        die("usage: [--sym FILE] at PC TRACE")
    pc = num(args[0], "pc")
    recs, symtab = load(args[1], sym)
    n = 0
    for r in recs:
        if r.type == T.T_EXEC and r.fields["pc"] == pc:
            print(render_exec(r, symtab))
            n += 1
    finish(n)


def cmd_last_write(args, sym):
    before = take_opt(args, "--before")
    if len(args) != 2:
        die("usage: [--sym FILE] last-write ADDR [--before CYCLE] TRACE")
    addr = num(args[0], "addr")
    before_c = num(before, "--before") if before is not None else None
    recs, symtab = load(args[1], sym)
    best = None
    for r in recs:
        if r.type in (T.T_MEMW, T.T_DEVW):
            f = r.fields
            if before_c is not None and f["cycle"] >= before_c:
                continue
            if f["ea"] <= addr < f["ea"] + f["size"]:
                best = r
    if best is None:
        finish(0)
    print(render_mem(best, symtab))
    finish(1)


def parse_regname(text):
    t = text.strip().lower()
    aliases = {"sp": 28, "ra": 29, "k0": 30, "zero": 31}
    if t in aliases:
        return ("r", aliases[t])
    if t.startswith("r") and t[1:].isdigit() and 0 <= int(t[1:]) <= 31:
        return ("r", int(t[1:]))
    if t.startswith("p") and t[1:].isdigit() and 0 <= int(t[1:]) <= 7:
        return ("p", int(t[1:]))
    die(f"bad register name {text!r}")


def cmd_reg(args, sym):
    if sym is not None:
        die("reg does not accept --sym")
    at = take_opt(args, "--at")
    if at is None or len(args) != 2:
        die("usage: reg R --at CYCLE TRACE")
    kind, idx = parse_regname(args[0])
    at_cycle = num(at, "--at")
    recs, _ = load(args[1], None)
    cycles = [r.fields["cycle"] for r in recs if "cycle" in r.fields]
    if not cycles or at_cycle > max(cycles):
        finish(0)  # trace.md 6.5.4: beyond the last record's cycle
    # reset state (ISA-SPEC 11): GPRs 0; predicate file p0=1, p1-p7=0
    if kind == "r" and idx == 31:
        val = 0
    elif kind == "p" and idx == 0:
        val = 1
    else:
        val = 0 if kind == "r" else (1 if idx == 0 else 0)
        for r in recs:
            if r.type != T.T_EXEC or r.fields["cycle"] > at_cycle:
                continue
            f = r.fields
            if kind == "r" and f["flags"] & T.FLAG_WROTE_DST \
                    and insn_field(f["insn"], "dst") == idx:
                val = f["wb"]
            if kind == "p" and f["flags"] & T.FLAG_WROTE_PRED:
                val = (f["pred_wb"] >> idx) & 1
    vtxt = h128(val) if kind == "r" else str(val)
    print(f"reg={kind}{idx} cycle={at_cycle} val={vtxt}")
    finish(1)


def cmd_find(args, sym):
    pc = take_opt(args, "--pc")
    wrote = take_opt(args, "--wrote-reg")
    touched = take_opt(args, "--touched")
    frm = take_opt(args, "--from")
    to = take_opt(args, "--to")
    if sum(x is not None for x in (pc, wrote, touched)) != 1:
        die("find needs exactly one of --pc, --wrote-reg, --touched")
    if len(args) != 1:
        die("usage: [--sym FILE] find (--pc X | --wrote-reg R=V | "
            "--touched A) [--from C] [--to C] TRACE")
    frm_c = num(frm, "--from") if frm is not None else 0
    to_c = num(to, "--to") if to is not None else None
    if pc is not None:
        pc_v = num(pc, "--pc")
    if touched is not None:
        touched_v = num(touched, "--touched")
    if wrote is not None:
        if "=" not in wrote:
            die("--wrote-reg wants R=V")
        rname, vtext = wrote.split("=", 1)
        kind, idx = parse_regname(rname)
        if kind != "r":
            die("--wrote-reg takes a GPR")
        want = num(vtext, "--wrote-reg value")
    recs, symtab = load(args[0], sym)

    def matches(r):
        f = r.fields
        c = f.get("cycle")
        if c is None or c < frm_c or (to_c is not None and c > to_c):
            return False
        if pc is not None:
            return r.type == T.T_EXEC and f["pc"] == pc_v
        if touched is not None:
            return r.type in (T.T_MEMW, T.T_MEMR, T.T_DEVW) \
                and f["ea"] <= touched_v < f["ea"] + f["size"]
        return (r.type == T.T_EXEC
                and bool(f["flags"] & T.FLAG_WROTE_DST)
                and insn_field(f["insn"], "dst") == idx
                and f["wb"] == want)

    for r in recs:
        if matches(r):
            print(render(r, symtab))
            finish(1)
    finish(0)


def cmd_diverge(args, sym):
    if sym is not None:
        die("diverge does not accept --sym")
    if len(args) != 2:
        die("usage: diverge A.trc B.trc")
    ra, _ = load(args[0], None)
    rb, _ = load(args[1], None)

    # record 0: META, compared key-by-key with run-variant keys excluded
    ma, mb = ra[0].fields["meta"], rb[0].fields["meta"]
    for key in T.META_KEYS:
        if key in T.META_RUN_VARIANT:
            continue
        if ma.get(key) != mb.get(key):
            print(f"record=0 key={key}")
            print(f"a={ma.get(key, '-')}")
            print(f"b={mb.get(key, '-')}")
            finish(1)

    n = min(len(ra), len(rb))
    for i in range(1, n):
        x, y = ra[i], rb[i]
        if (x.type, x.payload) != (y.type, y.payload):
            print(f"record={i} offset_a={x.offset} offset_b={y.offset}")
            print(f"a={render(x, None)}")
            print(f"b={render(y, None)}")
            finish(1)
    if len(ra) != len(rb):
        if len(ra) > len(rb):
            x = ra[n]
            print(f"record={n} offset_a={x.offset} offset_b=-")
            print(f"a={render(x, None)}")
            print("b=eof")
        else:
            y = rb[n]
            print(f"record={n} offset_a=- offset_b={y.offset}")
            print("a=eof")
            print(f"b={render(y, None)}")
        finish(1)
    finish(0)  # identical: no output, exit 1


def cmd_range(args, sym):
    if len(args) != 3:
        die("usage: [--sym FILE] range C1 C2 TRACE")
    c1, c2 = num(args[0], "C1"), num(args[1], "C2")
    recs, symtab = load(args[2], sym)
    n = 0
    for r in recs:
        if r.type in (T.T_EXEC, T.T_TRAP) \
                and c1 <= r.fields["cycle"] <= c2:
            print(render(r, symtab))
            n += 1
    finish(n)


def cmd_trapdump(args, sym):
    if len(args) != 1:
        die("usage: [--sym FILE] trapdump TRACE")
    recs, symtab = load(args[0], sym)
    n = 0
    for r in recs:
        if r.type == T.T_TRAP:
            print(render_trap(r, symtab))
            n += 1
    finish(n)


COMMANDS = {
    "exec": cmd_exec,
    "at": cmd_at,
    "last-write": cmd_last_write,
    "reg": cmd_reg,
    "find": cmd_find,
    "diverge": cmd_diverge,
    "range": cmd_range,
    "trapdump": cmd_trapdump,
}


def main():
    args = list(sys.argv[1:])
    if not args or args[0] in ("-h", "--help"):
        sys.exit(__doc__.strip())
    sym = take_opt(args, "--sym")  # accepted before or after the command
    if not args:
        die("no query given")
    cmd = args[0]
    if cmd not in COMMANDS:
        die(f"unknown query {cmd!r} (have: {', '.join(COMMANDS)})")
    COMMANDS[cmd](args[1:], sym)


if __name__ == "__main__":
    main()
